---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({ params: { id: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<Base title={`${post.data.title} — Juan Sutil Palma`} description={post.data.description} swapTitle={false}>
  <article class="post">
    <p class="mono date">{post.data.date.toISOString().slice(0, 10)}</p>
    <h1>{post.data.title}</h1>
    <div class="body"><Content /></div>
    <p class="back mono"><a href="/blog/">← ~/blog</a></p>
  </article>
</Base>

<style>
  .post{max-width:720px;margin:0 auto;padding:130px 24px 90px}
  .post h1{font-size:clamp(1.9rem,4.5vw,2.8rem);margin:10px 0 30px}
  .date{color:var(--faint);font-size:.78rem}
  .body :global(p){margin:0 0 1.2em;color:var(--paper)}
  .body :global(h2){margin:1.6em 0 .6em}
  .body :global(a){color:var(--ember)}
  .body :global(code){font-family:'IBM Plex Mono',monospace;font-size:.9em;background:var(--ink);padding:2px 5px;border-radius:3px}
  .body :global(pre){background:var(--ink);border:1px solid var(--line);padding:16px;overflow-x:auto;border-radius:4px;margin:0 0 1.2em}
  .back{margin-top:50px;font-size:.82rem}
</style>
