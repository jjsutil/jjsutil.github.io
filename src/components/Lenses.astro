---
import { t } from '../data/i18n';
---

<section id="lenses">
  <p class="sec-label" data-i18n="ln_label">{t('ln_label')}</p>
  <h2 data-i18n="ln_h2">{t('ln_h2')}</h2>
  <div class="lenses">
    <div class="lens reveal">
      <h3><em>01</em><span data-i18n="l1_h">{t('l1_h')}</span></h3>
      <p data-i18n="l1_p">{t('l1_p')}</p>
    </div>
    <div class="lens reveal">
      <h3><em>02</em><span data-i18n="l2_h">{t('l2_h')}</span></h3>
      <p data-i18n="l2_p">{t('l2_p')}</p>
    </div>
    <div class="lens reveal">
      <h3><em>03</em><span data-i18n="l3_h">{t('l3_h')}</span></h3>
      <p data-i18n="l3_p">{t('l3_p')}</p>
    </div>
  </div>
</section>
