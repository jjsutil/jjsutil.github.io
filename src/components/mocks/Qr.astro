<svg viewBox="0 0 220 88" preserveAspectRatio="xMidYMid meet" aria-hidden="true">
  <!-- qr: a sparse abstract grid with a quiet finder-corner hint. Missing cells
       materialize one by one, ember, ease-out, deliberate cadence. On completion
       the grid breathes once and a label lands. Base attributes render the
       completed grid for the static/reduced-motion frame. 10s master. -->

  <g class="qr-scene">
    <!-- finder-corner hint, top-left only -->
    <g class="qr-finder" stroke="var(--faint)" stroke-width="1.2" opacity=".55">
      <rect x="62" y="10" width="18" height="18" rx="1" fill="none"/>
      <rect x="67" y="15" width="8" height="8" rx="1" fill="var(--faint)" stroke="none"/>
    </g>

    <!-- intact cells, present from the start -->
    <g class="qr-intact" fill="var(--faint)" opacity=".5">
      <rect x="95" y="10" width="7" height="7" rx="1"/>
      <rect x="139" y="10" width="7" height="7" rx="1"/>
      <rect x="84" y="21" width="7" height="7" rx="1"/>
      <rect x="106" y="21" width="7" height="7" rx="1"/>
      <rect x="128" y="21" width="7" height="7" rx="1"/>
      <rect x="62" y="32" width="7" height="7" rx="1"/>
      <rect x="95" y="32" width="7" height="7" rx="1"/>
      <rect x="117" y="32" width="7" height="7" rx="1"/>
      <rect x="139" y="32" width="7" height="7" rx="1"/>
      <rect x="73" y="43" width="7" height="7" rx="1"/>
      <rect x="106" y="43" width="7" height="7" rx="1"/>
      <rect x="62" y="54" width="7" height="7" rx="1"/>
      <rect x="117" y="54" width="7" height="7" rx="1"/>
      <rect x="139" y="54" width="7" height="7" rx="1"/>
    </g>

    <!-- missing cells, recovered one by one -->
    <rect class="qr-cell qr-cell-a" x="117" y="10" width="7" height="7" rx="1" fill="var(--ember)"/>
    <rect class="qr-cell qr-cell-b" x="73" y="32" width="7" height="7" rx="1" fill="var(--ember)"/>
    <rect class="qr-cell qr-cell-c" x="128" y="32" width="7" height="7" rx="1" fill="var(--ember)"/>
    <rect class="qr-cell qr-cell-d" x="84" y="43" width="7" height="7" rx="1" fill="var(--ember)"/>
    <rect class="qr-cell qr-cell-e" x="95" y="43" width="7" height="7" rx="1" fill="var(--ember)"/>
    <rect class="qr-cell qr-cell-f" x="128" y="54" width="7" height="7" rx="1" fill="var(--ember)"/>
  </g>

  <text class="qr-label" x="104" y="78" font-size="8" fill="var(--ok)" text-anchor="middle">recovered</text>

  <style>
    .qr-scene { transform-box: view-box; transform-origin: 104px 34px; animation: qrBreathe 10s cubic-bezier(.4,0,.2,1) infinite; }
    @keyframes qrBreathe {
      0%, 71% { transform: scale(1); }
      75% { transform: scale(1.045); }
      80%, 100% { transform: scale(1); }
    }

    .qr-cell { transform-box: fill-box; transform-origin: center; }

    .qr-cell-a { animation: qrPopA 10s cubic-bezier(.2,.8,.3,1) infinite; }
    @keyframes qrPopA { 0%, 14% { opacity: 0; transform: scale(.4); } 16% { opacity: 1; transform: scale(1.15); } 19%, 96% { opacity: 1; transform: scale(1); } 100% { opacity: 0; transform: scale(.4); } }

    .qr-cell-b { animation: qrPopB 10s cubic-bezier(.2,.8,.3,1) infinite; }
    @keyframes qrPopB { 0%, 24% { opacity: 0; transform: scale(.4); } 26% { opacity: 1; transform: scale(1.15); } 29%, 96% { opacity: 1; transform: scale(1); } 100% { opacity: 0; transform: scale(.4); } }

    .qr-cell-c { animation: qrPopC 10s cubic-bezier(.2,.8,.3,1) infinite; }
    @keyframes qrPopC { 0%, 34% { opacity: 0; transform: scale(.4); } 36% { opacity: 1; transform: scale(1.15); } 39%, 96% { opacity: 1; transform: scale(1); } 100% { opacity: 0; transform: scale(.4); } }

    .qr-cell-d { animation: qrPopD 10s cubic-bezier(.2,.8,.3,1) infinite; }
    @keyframes qrPopD { 0%, 44% { opacity: 0; transform: scale(.4); } 46% { opacity: 1; transform: scale(1.15); } 49%, 96% { opacity: 1; transform: scale(1); } 100% { opacity: 0; transform: scale(.4); } }

    .qr-cell-e { animation: qrPopE 10s cubic-bezier(.2,.8,.3,1) infinite; }
    @keyframes qrPopE { 0%, 54% { opacity: 0; transform: scale(.4); } 56% { opacity: 1; transform: scale(1.15); } 59%, 96% { opacity: 1; transform: scale(1); } 100% { opacity: 0; transform: scale(.4); } }

    .qr-cell-f { animation: qrPopF 10s cubic-bezier(.2,.8,.3,1) infinite; }
    @keyframes qrPopF { 0%, 64% { opacity: 0; transform: scale(.4); } 66% { opacity: 1; transform: scale(1.15); } 69%, 96% { opacity: 1; transform: scale(1); } 100% { opacity: 0; transform: scale(.4); } }

    .qr-label { animation: qrLabel 10s ease-in-out infinite; }
    @keyframes qrLabel { 0%, 77% { opacity: 0; } 82%, 96% { opacity: 1; } 100% { opacity: 0; } }
  </style>
</svg>
