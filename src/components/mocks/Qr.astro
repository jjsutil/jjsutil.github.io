<svg viewBox="0 0 220 88" preserveAspectRatio="xMidYMid meet" aria-hidden="true">
  <!-- finder patterns: reads as a QR code -->
  <rect x="62" y="10" width="24" height="24" rx="1" fill="none" stroke="var(--paper)" stroke-width="2"/>
  <rect x="70" y="18" width="8" height="8" fill="var(--paper)"/>
  <rect x="134" y="10" width="24" height="24" rx="1" fill="none" stroke="var(--paper)" stroke-width="2"/>
  <rect x="142" y="18" width="8" height="8" fill="var(--paper)"/>
  <rect x="62" y="50" width="24" height="24" rx="1" fill="none" stroke="var(--paper)" stroke-width="2"/>
  <rect x="70" y="58" width="8" height="8" fill="var(--paper)"/>

  <!-- intact data modules -->
  <rect x="95" y="19" width="6" height="6" rx="1" fill="var(--paper)" opacity=".75"/>
  <rect x="111" y="19" width="6" height="6" rx="1" fill="var(--paper)" opacity=".75"/>
  <rect x="127" y="19" width="6" height="6" rx="1" fill="var(--paper)" opacity=".75"/>
  <rect x="95" y="35" width="6" height="6" rx="1" fill="var(--paper)" opacity=".75"/>
  <rect x="119" y="35" width="6" height="6" rx="1" fill="var(--paper)" opacity=".75"/>
  <rect x="143" y="43" width="6" height="6" rx="1" fill="var(--paper)" opacity=".75"/>
  <rect x="95" y="51" width="6" height="6" rx="1" fill="var(--paper)" opacity=".75"/>
  <rect x="143" y="51" width="6" height="6" rx="1" fill="var(--paper)" opacity=".75"/>
  <rect x="111" y="67" width="6" height="6" rx="1" fill="var(--paper)" opacity=".75"/>
  <rect x="127" y="67" width="6" height="6" rx="1" fill="var(--paper)" opacity=".75"/>
  <rect x="95" y="67" width="6" height="6" rx="1" fill="var(--paper)" opacity=".75"/>
  <rect x="135" y="59" width="6" height="6" rx="1" fill="var(--paper)" opacity=".75"/>

  <!-- damaged cluster reconstructing cell by cell (Reed-Solomon recovery) -->
  <rect class="qr-cell" style="animation-delay:0s" x="103" y="35" width="6" height="6" rx="1" fill="var(--ember)"/>
  <rect class="qr-cell" style="animation-delay:.35s" x="111" y="27" width="6" height="6" rx="1" fill="var(--ember)"/>
  <rect class="qr-cell" style="animation-delay:.7s" x="119" y="43" width="6" height="6" rx="1" fill="var(--ember)"/>
  <rect class="qr-cell" style="animation-delay:1.05s" x="127" y="35" width="6" height="6" rx="1" fill="var(--ember)"/>
  <rect class="qr-cell" style="animation-delay:1.4s" x="103" y="51" width="6" height="6" rx="1" fill="var(--ember)"/>
  <rect class="qr-cell" style="animation-delay:1.75s" x="135" y="27" width="6" height="6" rx="1" fill="var(--ember)"/>
  <rect class="qr-cell" style="animation-delay:2.1s" x="119" y="59" width="6" height="6" rx="1" fill="var(--ember)"/>
  <rect class="qr-cell" style="animation-delay:2.45s" x="103" y="67" width="6" height="6" rx="1" fill="var(--ember)"/>

  <!-- scanning pass over the grid -->
  <line class="qr-scan" x1="62" y1="10" x2="158" y2="10" stroke="var(--ember)" stroke-width="1"/>

  <!-- byte-level verification readout -->
  <text class="qr-check" style="animation-delay:0s" x="166" y="22" font-size="7" fill="var(--ok)">byte 0x4F ✓</text>
  <text class="qr-check" style="animation-delay:.9s" x="166" y="34" font-size="7" fill="var(--ok)">byte 0xA2 ✓</text>
  <text class="qr-check" style="animation-delay:1.8s" x="166" y="46" font-size="7" fill="var(--ok)">byte 0xC9 ✓</text>
  <text x="166" y="62" font-size="7" fill="var(--faint)">Reed-Solomon</text>
  <text x="166" y="71" font-size="7" fill="var(--faint)">recovery</text>

  <style>
    @keyframes qrPop { 0%, 8% { opacity: 0; transform: scale(.5); } 20%, 90% { opacity: 1; transform: scale(1); } 100% { opacity: 1; } }
    @keyframes qrCheck { 0%, 10% { opacity: 0; } 25%, 100% { opacity: 1; } }
    @keyframes qrScan { 0% { transform: translateY(0); opacity: .9; } 92% { transform: translateY(56px); opacity: .9; } 100% { transform: translateY(56px); opacity: 0; } }

    .qr-cell { animation: qrPop 3.6s ease infinite; transform-box: fill-box; transform-origin: center; }
    .qr-check { animation: qrCheck 3.6s ease infinite; }
    .qr-scan { animation: qrScan 3.6s ease-in-out infinite; transform-box: fill-box; transform-origin: center; }
  </style>
</svg>
