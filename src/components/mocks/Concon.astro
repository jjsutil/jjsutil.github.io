<svg viewBox="0 0 220 88" preserveAspectRatio="xMidYMid meet" aria-hidden="true">
  <!-- concon, abstracted: seven bars rise from a quiet baseline against
       gridlines, one of them the standard. those that clear it earn a
       small ember cap. sober, precise, no drama. one label. 10s. -->

  <g class="concon-grid">
    <line x1="16" y1="24" x2="204" y2="24" stroke="var(--faint)" stroke-width="1" opacity=".25"/>
    <line x1="16" y1="56" x2="204" y2="56" stroke="var(--faint)" stroke-width="1" opacity=".25"/>
    <line x1="16" y1="70" x2="204" y2="70" stroke="var(--faint)" stroke-width="1" opacity=".4"/>
  </g>
  <line class="concon-standard" x1="16" y1="38" x2="204" y2="38" stroke="var(--faint)" stroke-width="1.2" opacity=".6"/>

  <g stroke="var(--faint)" stroke-width="3" stroke-linecap="round">
    <line class="concon-bar-a" x1="26" y1="70" x2="26" y2="52"/>
    <line class="concon-bar-b" x1="53" y1="70" x2="53" y2="28"/>
    <line class="concon-bar-c" x1="80" y1="70" x2="80" y2="46"/>
    <line class="concon-bar-a" x1="107" y1="70" x2="107" y2="16"/>
    <line class="concon-bar-b" x1="134" y1="70" x2="134" y2="58"/>
    <line class="concon-bar-c" x1="161" y1="70" x2="161" y2="32"/>
    <line class="concon-bar-b" x1="188" y1="70" x2="188" y2="50"/>
  </g>

  <g class="concon-caps" fill="var(--ember)">
    <circle cx="53" cy="28" r="1.8"/>
    <circle cx="107" cy="16" r="1.8"/>
    <circle cx="161" cy="32" r="1.8"/>
  </g>

  <text class="concon-label" x="188" y="82" font-size="9" fill="var(--paper)" text-anchor="end">247</text>

  <style>
    .concon-grid, .concon-standard, .concon-bar-a, .concon-bar-b, .concon-bar-c, .concon-caps, .concon-label {
      animation-duration: 10s;
      animation-iteration-count: infinite;
      animation-timing-function: cubic-bezier(.4,0,.2,1);
    }
    .concon-bar-a, .concon-bar-b, .concon-bar-c {
      transform-box: fill-box;
      transform-origin: center bottom;
      animation-timing-function: cubic-bezier(.2,.6,.25,1);
    }

    /* 0-6%: grid and standard line settle in; long hold; soft reset */
    .concon-grid, .concon-standard { animation-name: conconGrid; }
    @keyframes conconGrid {
      0% { opacity: 0; }
      6%, 96% { opacity: 1; }
      100% { opacity: 0; }
    }

    /* staggered bar growth, three groups within one timeline */
    .concon-bar-a { animation-name: conconBarA; }
    @keyframes conconBarA {
      0%, 8% { transform: scaleY(0); opacity: .4; }
      10% { opacity: 1; }
      24%, 96% { transform: scaleY(1); opacity: 1; }
      100% { opacity: 0; }
    }
    .concon-bar-b { animation-name: conconBarB; }
    @keyframes conconBarB {
      0%, 14% { transform: scaleY(0); opacity: .4; }
      16% { opacity: 1; }
      30%, 96% { transform: scaleY(1); opacity: 1; }
      100% { opacity: 0; }
    }
    .concon-bar-c { animation-name: conconBarC; }
    @keyframes conconBarC {
      0%, 20% { transform: scaleY(0); opacity: .4; }
      22% { opacity: 1; }
      36%, 96% { transform: scaleY(1); opacity: 1; }
      100% { opacity: 0; }
    }

    /* 40-46%: bars that cleared the standard earn their ember cap */
    .concon-caps { animation-name: conconCaps; }
    @keyframes conconCaps {
      0%, 40% { opacity: 0; }
      46%, 96% { opacity: 1; }
      100% { opacity: 0; }
    }

    /* 50-56%: the count lands; payoff holds long; soft reset */
    .concon-label { animation-name: conconLabel; }
    @keyframes conconLabel {
      0%, 50% { opacity: 0; }
      56%, 96% { opacity: 1; }
      100% { opacity: 0; }
    }
  </style>
</svg>
