<svg viewBox="0 0 220 88" preserveAspectRatio="xMidYMid meet" aria-hidden="true">
  <!-- s67: a ring of twelve quiet ticks, a thin hand sweeping from center.
       It crosses the six and the seven — both ignite ember, and a soft bloom
       of tiny points drifts outward from the ring and settles. One label
       lands and holds. One 12s master timeline. -->

  <!-- the ring: twelve quiet ticks -->
  <g class="s67-ring" stroke="var(--faint)" stroke-width="1.2" stroke-linecap="round">
    <line x1="122.5" y1="22.4" x2="125" y2="18"/>
    <line x1="131.7" y1="31.5" x2="136" y2="29"/>
    <line x1="135" y1="44" x2="140" y2="44"/>
    <line x1="131.7" y1="56.5" x2="136" y2="59"/>
    <line x1="122.5" y1="65.7" x2="125" y2="70"/>
    <line x1="110" y1="69" x2="110" y2="74"/>
    <line x1="97.5" y1="65.7" x2="95" y2="70"/>
    <line x1="88.4" y1="56.5" x2="84" y2="59"/>
    <line x1="85" y1="44" x2="80" y2="44"/>
    <line x1="88.4" y1="31.5" x2="84" y2="29"/>
    <line x1="97.5" y1="22.4" x2="95" y2="18"/>
    <line x1="110" y1="19" x2="110" y2="14"/>
  </g>

  <!-- the hand: drawn already at its final (6:07) heading, rotated back for the sweep -->
  <line class="s67-hand" x1="110" y1="44" x2="89" y2="61"
    stroke="var(--paper)" stroke-width="1.5" stroke-linecap="round"/>

  <!-- the two ticks it wakes -->
  <line class="s67-t6" x1="110" y1="69" x2="110" y2="74"
    stroke="var(--ember)" stroke-width="1.6" stroke-linecap="round"/>
  <line class="s67-t7" x1="97.5" y1="65.7" x2="95" y2="70"
    stroke="var(--ember)" stroke-width="1.6" stroke-linecap="round"/>

  <!-- the bloom: the feed waking, drifting out from the ring, settling -->
  <g class="s67-bloom" fill="var(--ember)">
    <circle cx="120.4" cy="82.6" r="1" style="--dx:-20.4px; --dy:-10.6px"/>
    <circle cx="106.3" cy="85.8" r="1.1" style="--dx:-6.3px; --dy:-13.8px"/>
    <circle cx="97" cy="79.7" r="1" style="--dx:3px; --dy:-7.7px"/>
    <circle cx="83.6" cy="81.7" r="1.2" style="--dx:16.4px; --dy:-9.7px"/>
    <circle cx="79.4" cy="69.7" r="1" style="--dx:20.6px; --dy:2.3px"/>
    <circle cx="70.1" cy="62.6" r="1.1" style="--dx:29.9px; --dy:9.4px"/>
  </g>

  <text class="s67-label" x="140" y="80" font-size="9" fill="var(--ember)">6:07</text>

  <style>
    .s67-hand, .s67-t6, .s67-t7, .s67-bloom circle, .s67-label {
      animation-duration: 12s;
      animation-iteration-count: infinite;
      animation-timing-function: ease-in-out;
    }

    /* the hand sweeps slowly, from 12 to just past 7, then holds */
    .s67-hand {
      transform-origin: 110px 44px;
      animation-name: s67Hand;
      animation-timing-function: cubic-bezier(.4,0,.2,1);
    }
    @keyframes s67Hand {
      0%, 6% { transform: rotate(-230deg); opacity: 0; }
      9% { opacity: .9; transform: rotate(-230deg); }
      50% { transform: rotate(0deg); opacity: .9; }
      92%, 100% { transform: rotate(0deg); opacity: 0; }
    }

    /* it crosses the six, then the seven — both ignite and stay */
    .s67-t6 { animation-name: s67T6; }
    @keyframes s67T6 {
      0%, 40% { opacity: 0; }
      43%, 90% { opacity: 1; }
      95%, 100% { opacity: 0; }
    }
    .s67-t7 { animation-name: s67T7; }
    @keyframes s67T7 {
      0%, 45% { opacity: 0; }
      48%, 90% { opacity: 1; }
      95%, 100% { opacity: 0; }
    }

    /* the bloom drifts out from the ring and settles, ease-out */
    .s67-bloom circle {
      animation-name: s67Bloom;
      animation-timing-function: cubic-bezier(0,0,.2,1);
    }
    @keyframes s67Bloom {
      0%, 49% { transform: translate(var(--dx), var(--dy)); opacity: 0; }
      53% { opacity: 1; }
      64%, 90% { transform: translate(0, 0); opacity: .6; }
      95%, 100% { opacity: 0; }
    }

    /* the label lands, holds */
    .s67-label { animation-name: s67Label; }
    @keyframes s67Label {
      0%, 64% { opacity: 0; }
      69%, 90% { opacity: 1; }
      95%, 100% { opacity: 0; }
    }
  </style>
</svg>
