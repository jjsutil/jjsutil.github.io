<svg viewBox="0 0 220 88" preserveAspectRatio="xMidYMid meet" aria-hidden="true">
  <!-- pin, abstracted: a field of quiet lines (the case file), a slow band of
       light reads it, one line ignites, a single point of evidence travels out
       and closes a ring — the citation. One label. One 10s master timeline. -->

  <defs>
    <linearGradient id="pin-band" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="var(--ember)" stop-opacity="0"/>
      <stop offset="1" stop-color="var(--ember)" stop-opacity=".14"/>
    </linearGradient>
  </defs>

  <!-- the document: nine quiet lines -->
  <g class="pin-field" stroke-linecap="round" stroke-width="1.6">
    <line x1="24" y1="16" x2="86" y2="16" stroke="var(--faint)" opacity=".28"/>
    <line x1="24" y1="24" x2="78" y2="24" stroke="var(--faint)" opacity=".38"/>
    <line x1="24" y1="32" x2="90" y2="32" stroke="var(--faint)" opacity=".25"/>
    <line x1="24" y1="40" x2="82" y2="40" stroke="var(--faint)" opacity=".34"/>
    <line class="pin-hit" x1="24" y1="48" x2="88" y2="48" stroke="var(--ember)"/>
    <line x1="24" y1="56" x2="74" y2="56" stroke="var(--faint)" opacity=".3"/>
    <line x1="24" y1="64" x2="86" y2="64" stroke="var(--faint)" opacity=".26"/>
    <line x1="24" y1="72" x2="68" y2="72" stroke="var(--faint)" opacity=".36"/>
  </g>

  <!-- the reading: a soft band of light descending over the field -->
  <g class="pin-beam">
    <rect x="20" y="-12" width="74" height="12" fill="url(#pin-band)"/>
    <line x1="20" y1="0" x2="94" y2="0" stroke="var(--ember)" stroke-width="1" opacity=".8"/>
  </g>

  <!-- the evidence: one point leaves the lit line… -->
  <circle class="pin-dot" cx="88" cy="48" r="2" fill="var(--ember)"/>

  <!-- …and closes the citation ring -->
  <circle class="pin-ring" cx="160" cy="44" r="9" fill="none" stroke="var(--ember)" stroke-width="1.4"
    stroke-linecap="round" transform="rotate(-90 160 44)"/>
  <circle class="pin-core" cx="160" cy="44" r="2" fill="var(--ember)"/>
  <text class="pin-label" x="178" y="47" font-size="8" fill="var(--paper)">p. 147</text>

  <style>
    .pin-field, .pin-beam, .pin-hit, .pin-dot, .pin-ring, .pin-core, .pin-label {
      animation-duration: 10s;
      animation-iteration-count: infinite;
      animation-timing-function: ease-in-out;
    }

    /* 0-6%: the field breathes in */
    .pin-field { animation-name: pinField; }
    @keyframes pinField {
      0% { opacity: 0; }
      6%, 100% { opacity: 1; }
    }

    /* 6-36%: one slow pass of the reading band */
    .pin-beam { animation-name: pinBeam; animation-timing-function: cubic-bezier(.5,0,.5,1); }
    @keyframes pinBeam {
      0%, 6% { transform: translateY(6px); opacity: 0; }
      9% { opacity: 1; }
      33% { opacity: 1; }
      36%, 100% { transform: translateY(86px); opacity: 0; }
    }

    /* ~28%: the band crosses y=48 — the line ignites, and stays */
    .pin-hit { animation-name: pinHit; }
    @keyframes pinHit {
      0%, 27% { stroke: var(--faint); opacity: .3; }
      31%, 96% { stroke: var(--ember); opacity: 1; }
      100% { stroke: var(--ember); opacity: .3; }
    }

    /* 42-58%: the point of evidence travels (CSS transform — SMIL freezes in
       panels that mount hidden, see the sibling scenes) */
    .pin-dot { animation-name: pinDot; animation-timing-function: cubic-bezier(.4,0,.2,1); }
    @keyframes pinDot {
      0%, 40% { opacity: 0; transform: translate(0, 0); }
      42% { opacity: 1; transform: translate(0, 0); }
      58%, 96% { opacity: 1; transform: translate(72px, -4px); }
      100% { opacity: 0; transform: translate(72px, -4px); }
    }

    /* 58-72%: the ring draws itself closed */
    .pin-ring {
      stroke-dasharray: 56.6; /* 2πr, r=9 */
      animation-name: pinRing;
      animation-timing-function: cubic-bezier(.3,0,.2,1);
    }
    @keyframes pinRing {
      0%, 57% { stroke-dashoffset: 56.6; opacity: 0; }
      59% { opacity: 1; }
      72%, 96% { stroke-dashoffset: 0; opacity: 1; }
      100% { stroke-dashoffset: 0; opacity: 0; }
    }
    .pin-core { animation-name: pinCore; }
    @keyframes pinCore {
      0%, 56% { opacity: 0; }
      60%, 96% { opacity: 1; }
      100% { opacity: 0; }
    }

    /* 74-80%: the label lands; long hold; soft reset */
    .pin-label { animation-name: pinLabel; }
    @keyframes pinLabel {
      0%, 73% { opacity: 0; }
      79%, 96% { opacity: 1; }
      100% { opacity: 0; }
    }
  </style>
</svg>
