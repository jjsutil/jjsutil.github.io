<svg viewBox="0 0 220 88" preserveAspectRatio="xMidYMid meet" aria-hidden="true">
  <text x="10" y="8" font-size="7" fill="var(--faint)">source.pdf</text>
  <rect x="10" y="12" width="62" height="66" rx="3" fill="none" stroke="var(--line)"/>
  <rect x="16" y="19" width="50" height="5" rx="1" fill="var(--faint)" opacity=".5"/>
  <rect x="16" y="29" width="44" height="4" rx="2" fill="var(--line)"/>
  <rect x="16" y="37" width="48" height="4" rx="2" fill="var(--line)"/>
  <rect class="pin-hit" x="16" y="45" width="46" height="4" rx="2" fill="var(--ember)"/>
  <rect x="16" y="53" width="34" height="4" rx="2" fill="var(--line)"/>
  <rect x="16" y="61" width="42" height="4" rx="2" fill="var(--line)"/>
  <rect x="16" y="69" width="38" height="4" rx="2" fill="var(--line)"/>
  <circle cx="66" cy="47" r="2.2" fill="var(--ember)"/>

  <g class="pin-spin"><circle cx="110" cy="45" r="11" fill="none" stroke="var(--faint)" stroke-width="2" stroke-dasharray="5 6"/></g>
  <circle class="pin-core" cx="110" cy="45" r="5" fill="var(--ember)"/>

  <path class="pin-flow-a" d="M76 45 H97" fill="none" stroke="var(--faint)" stroke-width="1.4" stroke-dasharray="4 5"/>
  <path d="M92 41 l5 4 -5 4" fill="none" stroke="var(--faint)" stroke-width="1.4"/>
  <path class="pin-flow-b" d="M123 45 H140" fill="none" stroke="var(--faint)" stroke-width="1.4" stroke-dasharray="4 5"/>
  <path d="M136 41 l5 4 -5 4" fill="none" stroke="var(--faint)" stroke-width="1.4"/>

  <rect x="134" y="14" width="76" height="17" rx="6" fill="none" stroke="var(--faint)"/>
  <text x="141" y="25.5" font-size="8" fill="var(--faint)">cite art. 19?</text>

  <g class="pin-answer">
    <rect x="148" y="37" width="64" height="17" rx="6" fill="none" stroke="var(--paper)"/>
    <text x="155" y="48.5" font-size="8" fill="var(--paper)">&#8594; p. 147</text>
  </g>

  <g class="pin-chip">
    <rect x="158" y="60" width="52" height="15" rx="6" fill="none" stroke="var(--ok)"/>
    <text x="164" y="70.5" font-size="7.5" fill="var(--ok)">cite &#10003;</text>
  </g>
</svg>

<style>
  @keyframes pinSpin{to{transform:rotate(360deg)}}
  @keyframes pinCorePulse{0%,100%{opacity:.35}50%{opacity:1}}
  @keyframes pinHitPulse{0%,100%{opacity:.45}50%{opacity:1}}
  @keyframes pinFlow{to{stroke-dashoffset:-18}}
  @keyframes pinPop{0%,10%{opacity:0;transform:scale(.6)}22%,88%{opacity:1;transform:scale(1)}100%{opacity:0}}

  .pin-spin{transform-box:fill-box;transform-origin:center;animation:pinSpin 3s linear infinite}
  .pin-core{animation:pinCorePulse 1.8s ease-in-out infinite}
  .pin-hit{animation:pinHitPulse 2.4s ease-in-out infinite}
  .pin-flow-a{animation:pinFlow 1s linear infinite}
  .pin-flow-b{animation:pinFlow 1.1s linear infinite}
  .pin-answer{transform-box:fill-box;transform-origin:center;animation:pinPop 4.5s ease infinite}
  .pin-chip{transform-box:fill-box;transform-origin:center;animation:pinPop 4.5s 1.4s ease infinite}
</style>
