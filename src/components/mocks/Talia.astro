<svg viewBox="0 0 220 88" preserveAspectRatio="xMidYMid meet" aria-hidden="true">
  <!-- talia, abstracted: three faint points in dark space, sound rippling outward
       in staggered generations until the point where they meet catches — the
       detection. One hairline rises from it to the single label. One 10s master
       timeline: points settle, ripples cross, ignition holds, label lands. -->

  <circle class="talia-point" cx="38" cy="24" r="2.2" fill="var(--faint)"/>
  <circle class="talia-point" cx="34" cy="68" r="2.2" fill="var(--faint)"/>
  <circle class="talia-point" cx="188" cy="44" r="2.2" fill="var(--faint)"/>

  <circle class="talia-ring talia-ring-a" cx="38" cy="24" r="0" fill="none" stroke="var(--ember)" stroke-width="1.2"/>
  <circle class="talia-ring talia-ring-b" cx="34" cy="68" r="0" fill="none" stroke="var(--ember)" stroke-width="1.2"/>
  <circle class="talia-ring talia-ring-c" cx="188" cy="44" r="0" fill="none" stroke="var(--ember)" stroke-width="1.2"/>

  <line class="talia-hairline" x1="118" y1="46" x2="118" y2="18" stroke="var(--rust)"
    stroke-width="1.4" stroke-linecap="round" pathLength="1" stroke-dasharray="1"/>

  <circle class="talia-ignite" cx="118" cy="46" r="3.4" fill="var(--rust)"/>

  <text class="talia-label" x="122" y="21" font-size="8" fill="var(--rust)">98%</text>

  <style>
    .talia-point, .talia-ring-a, .talia-ring-b, .talia-ring-c,
    .talia-hairline, .talia-ignite, .talia-label {
      animation-duration: 10s;
      animation-iteration-count: infinite;
      animation-timing-function: cubic-bezier(.4,0,.2,1);
    }

    /* 0-10%: the three points settle in (setup) */
    .talia-point { animation-name: taliaPoint; }
    @keyframes taliaPoint {
      0%, 6% { opacity: 0; }
      10%, 100% { opacity: 1; }
    }

    /* two ripple generations per point, staggered so they converge on the meeting point */
    .talia-ring-a { animation-name: taliaRingA; }
    @keyframes taliaRingA {
      0%, 8% { r: 0; opacity: 0; }
      13% { opacity: .5; }
      21%, 25% { r: 30; opacity: 0; }
      29% { opacity: .38; }
      37%, 100% { r: 30; opacity: 0; }
    }
    .talia-ring-b { animation-name: taliaRingB; }
    @keyframes taliaRingB {
      0%, 15% { r: 0; opacity: 0; }
      20% { opacity: .5; }
      28%, 32% { r: 30; opacity: 0; }
      36% { opacity: .38; }
      44%, 100% { r: 30; opacity: 0; }
    }
    .talia-ring-c { animation-name: taliaRingC; }
    @keyframes taliaRingC {
      0%, 21% { r: 0; opacity: 0; }
      26% { opacity: .5; }
      34%, 38% { r: 26; opacity: 0; }
      42% { opacity: .38; }
      50%, 100% { r: 26; opacity: 0; }
    }

    /* ~54%: ignition — the point where the ripples meet catches, and stays lit */
    .talia-ignite {
      animation-name: taliaIgnite, taliaIgniteBreath;
      transform-box: fill-box;
      transform-origin: center;
    }
    @keyframes taliaIgnite {
      0%, 49% { fill: var(--faint); r: 2; opacity: .55; }
      54% { fill: var(--rust); r: 4.2; opacity: 1; }
      58%, 96% { fill: var(--rust); r: 3.4; opacity: 1; }
      100% { fill: var(--rust); r: 3.4; opacity: 0; }
    }
    @keyframes taliaIgniteBreath {
      0%, 58% { transform: scale(1); }
      74% { transform: scale(1.16); }
      86% { transform: scale(1); }
      92% { transform: scale(1.1); }
      96%, 100% { transform: scale(1); }
    }

    /* the hairline draws once ignition catches */
    .talia-hairline { animation-name: taliaHairline; }
    @keyframes taliaHairline {
      0%, 56% { stroke-dashoffset: 1; opacity: 0; }
      60% { opacity: 1; }
      64%, 96% { stroke-dashoffset: 0; opacity: 1; }
      100% { opacity: 0; }
    }

    /* the label lands, holds, soft-fades in the final 4% */
    .talia-label { animation-name: taliaLabel; }
    @keyframes taliaLabel {
      0%, 63% { opacity: 0; }
      68%, 96% { opacity: 1; }
      100% { opacity: 0; }
    }
  </style>
</svg>
