<svg viewBox="0 0 220 88" preserveAspectRatio="xMidYMid meet" aria-hidden="true">
  <!-- queltehue, abstracted: a thin ember line runs, hits a fork, stops.
       one ripple calls the human out. a beat of stillness. one branch is
       chosen and the line continues, ember, to the edge. one label. 11s. -->

  <!-- the run -->
  <path class="quel-line" d="M20 44 L120 44" pathLength="1" stroke-dasharray="1"
    fill="none" stroke="var(--ember)" stroke-width="1.6" stroke-linecap="round"/>

  <!-- the fork: two quiet possibilities -->
  <path class="quel-branch" d="M120 44 Q160 44 195 68" fill="none"
    stroke="var(--faint)" stroke-width="1.2" stroke-dasharray="3 3"/>
  <path class="quel-branch" d="M120 44 Q160 44 195 20" fill="none"
    stroke="var(--faint)" stroke-width="1.2" stroke-dasharray="3 3"/>

  <!-- the ripple: a call to the human -->
  <circle class="quel-ripple" cx="120" cy="44" r="0" fill="none" stroke="var(--rust)" stroke-width="1.2"/>

  <!-- the chosen path, ember, drawn over the upper branch -->
  <path class="quel-chosen" d="M120 44 Q160 44 195 20" pathLength="1" stroke-dasharray="1"
    fill="none" stroke="var(--ember)" stroke-width="1.6" stroke-linecap="round"/>

  <text class="quel-label" x="126" y="62" font-size="7" fill="var(--faint)">human ok</text>

  <style>
    .quel-line, .quel-branch, .quel-ripple, .quel-chosen, .quel-label {
      animation-duration: 11s;
      animation-iteration-count: infinite;
      animation-timing-function: cubic-bezier(.4,0,.2,1);
    }

    /* 6-26%: the line draws itself to the fork; long hold; soft reset */
    .quel-line { animation-name: quelLine; animation-timing-function: cubic-bezier(.5,0,.4,1); }
    @keyframes quelLine {
      0%, 4% { opacity: 0; stroke-dashoffset: 1; }
      6% { opacity: 1; }
      26% { stroke-dashoffset: 0; }
      96% { opacity: 1; }
      100% { opacity: 0; }
    }

    /* 24-30%: the two branches ahead come into view as the line arrives */
    .quel-branch { animation-name: quelBranch; }
    @keyframes quelBranch {
      0%, 24% { opacity: 0; }
      30%, 96% { opacity: 1; }
      100% { opacity: 0; }
    }

    /* 32-48%: one ripple, expanding and fading — the call out */
    .quel-ripple { animation-name: quelRipple; animation-timing-function: cubic-bezier(.2,0,.3,1); }
    @keyframes quelRipple {
      0%, 32% { r: 0; opacity: .85; }
      48% { r: 16; opacity: 0; }
      100% { r: 16; opacity: 0; }
    }

    /* 54-72%: chosen path draws, ember, after the beat of stillness */
    .quel-chosen { animation-name: quelChosen; animation-timing-function: cubic-bezier(.3,0,.2,1); }
    @keyframes quelChosen {
      0%, 54% { opacity: 0; stroke-dashoffset: 1; }
      56% { opacity: 1; }
      72% { stroke-dashoffset: 0; }
      96% { opacity: 1; }
      100% { opacity: 0; }
    }

    /* 68-74%: the label lands; payoff holds to 96%; soft reset */
    .quel-label { animation-name: quelLabel; }
    @keyframes quelLabel {
      0%, 68% { opacity: 0; }
      74%, 96% { opacity: 1; }
      100% { opacity: 0; }
    }
  </style>
</svg>
