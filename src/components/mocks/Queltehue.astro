<svg viewBox="0 0 220 88" preserveAspectRatio="xMidYMid meet" aria-hidden="true">
  <!-- terminal: the agent hits a risky fork -->
  <rect x="8" y="8" width="120" height="50" rx="4" fill="var(--ink)" stroke="var(--line)"/>
  <circle cx="17" cy="17" r="1.6" fill="var(--rust)"/>
  <circle cx="24" cy="17" r="1.6" fill="var(--ember)"/>
  <circle cx="31" cy="17" r="1.6" fill="var(--ok)"/>
  <!-- tiny fork/branch glyph: safe path vs risky path -->
  <path d="M16 26 v4 q0 4 4 4 h4" fill="none" stroke="var(--ok)" stroke-width="1.2"/>
  <path d="M16 26 v4 q0 8 4 8 h4" fill="none" stroke="var(--rust)" stroke-width="1.2"/>
  <circle cx="16" cy="26" r="1.6" fill="var(--faint)"/>
  <text x="16" y="42" font-size="7" fill="var(--faint)">$ git push origin main</text>
  <text x="16" y="52" font-size="8.5" fill="var(--faint)">$ agent:</text>
  <text x="53" y="52" font-size="8.5" fill="var(--rust)">force-push?</text>
  <text class="quel-cursor" x="118" y="52" font-size="8.5" fill="var(--rust)">▊</text>
  <g class="quel-warn">
    <circle cx="111" cy="16" r="6" fill="none" stroke="var(--rust)" stroke-width="1.3"/>
    <text x="108.5" y="19" font-size="8" fill="var(--rust)">!</text>
  </g>

  <!-- escalation path from terminal to the human -->
  <path d="M128 50 C140 50 146 40 152 33" fill="none" stroke="var(--faint)" stroke-width="1.2"/>
  <path d="M152 33 l-4 1 1 -5" fill="none" stroke="var(--faint)" stroke-width="1.2"/>
  <circle class="quel-travel" cx="130" cy="50" r="2" fill="var(--ember)"/>

  <!-- ringing phone: sentinel reaches the human -->
  <path class="quel-wave" style="animation-delay:0s" d="M154 20 a11 11 0 0 0 0 20" fill="none" stroke="var(--faint)" stroke-width="1.2"/>
  <path class="quel-wave" style="animation-delay:.3s" d="M190 20 a11 11 0 0 1 0 20" fill="none" stroke="var(--faint)" stroke-width="1.2"/>
  <g class="quel-phone">
    <rect x="161" y="12" width="22" height="36" rx="5" fill="none" stroke="var(--ember)" stroke-width="1.6"/>
    <rect x="165" y="17" width="14" height="20" rx="1" fill="none" stroke="var(--faint)" stroke-width="1"/>
    <circle cx="172" cy="44" r="1.6" fill="var(--ember)"/>
  </g>

  <!-- confirmation card: human notified -->
  <g class="quel-card">
    <rect x="148" y="58" width="66" height="22" rx="5" fill="var(--ink)" stroke="var(--ok)"/>
    <path d="M155 66 l10 3 -10 3 2 -3 z" fill="var(--ok)"/>
    <text x="169" y="72" font-size="7" fill="var(--ok)">human notified ✓</text>
  </g>

  <style>
    @keyframes quelBlink { 0%, 49% { opacity: 1; } 50%, 100% { opacity: .12; } }
    @keyframes quelPulse { 0%, 100% { opacity: .35; } 50% { opacity: 1; } }
    @keyframes quelTravel { 0%, 8% { transform: translateX(0); } 45%, 100% { transform: translateX(22px) translateY(-16px); } }
    @keyframes quelWave { 0%, 100% { opacity: .2; } 50% { opacity: 1; } }
    @keyframes quelRing { 0%, 40%, 100% { transform: rotate(0deg); } 45% { transform: rotate(-9deg); } 50% { transform: rotate(9deg); } 55% { transform: rotate(-6deg); } 60% { transform: rotate(0deg); } }
    @keyframes quelPop { 0%, 55% { opacity: 0; transform: scale(.7); } 70%, 95% { opacity: 1; transform: scale(1); } 100% { opacity: 0; } }

    .quel-cursor { animation: quelBlink 1s steps(1, end) infinite; }
    .quel-warn { animation: quelPulse 2s ease-in-out infinite; transform-box: fill-box; transform-origin: center; }
    .quel-travel { animation: quelTravel 4.5s ease-in-out infinite; transform-box: fill-box; transform-origin: center; }
    .quel-wave { animation: quelWave 4.5s ease-in-out infinite; transform-box: fill-box; transform-origin: center; }
    .quel-phone { animation: quelRing 4.5s ease-in-out infinite; transform-box: fill-box; transform-origin: center; }
    .quel-card { animation: quelPop 4.5s ease infinite; transform-box: fill-box; transform-origin: center; opacity: 1; }
  </style>
</svg>
