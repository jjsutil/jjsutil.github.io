<svg viewBox="0 0 220 88" preserveAspectRatio="xMidYMid meet" aria-hidden="true">
  <!-- juanos: five quiet lines, the day's noise. Two dim almost out; three
       brighten to paper and gently gather; a thin ember bracket draws itself
       beside them. Calm, deterministic, long hold. One 10s master timeline. -->

  <!-- the noise: two lines that dim away -->
  <g class="juanos-noise" stroke="var(--faint)" stroke-width="1.4" stroke-linecap="round">
    <line x1="40" y1="34" x2="180" y2="34"/>
    <line x1="40" y1="62" x2="180" y2="62"/>
  </g>

  <!-- the three that remain: drawn at their final, gathered position -->
  <line class="juanos-l1" x1="40" y1="28" x2="180" y2="28"
    stroke="var(--paper)" stroke-width="1.4" stroke-linecap="round"/>
  <line class="juanos-l3" x1="40" y1="48" x2="180" y2="48"
    stroke="var(--paper)" stroke-width="1.4" stroke-linecap="round"/>
  <line class="juanos-l5" x1="40" y1="68" x2="180" y2="68"
    stroke="var(--paper)" stroke-width="1.4" stroke-linecap="round"/>

  <!-- the ember bracket, drawn along the gathered lines -->
  <path class="juanos-bracket" d="M36 26 L32 26 L32 70 L36 70"
    fill="none" stroke="var(--ember)" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>

  <text class="juanos-label" x="8" y="51" font-size="9" fill="var(--ember)">&#8804;3</text>

  <style>
    .juanos-noise, .juanos-l1, .juanos-l3, .juanos-l5, .juanos-bracket, .juanos-label {
      animation-duration: 10s;
      animation-iteration-count: infinite;
      animation-timing-function: ease-in-out;
    }

    /* setup: the five lines fade in, evenly spaced, all faint */
    .juanos-noise, .juanos-l1, .juanos-l3, .juanos-l5 {
      animation-timing-function: cubic-bezier(.4,0,.2,1);
    }

    /* the noise dims slowly and stays low */
    .juanos-noise { animation-name: juanosNoise; }
    @keyframes juanosNoise {
      0%, 4% { opacity: 0; }
      12%, 14% { opacity: .5; }
      38%, 90% { opacity: .08; }
      95%, 100% { opacity: 0; }
    }

    /* the three survivors brighten and gather toward their final spacing */
    .juanos-l1 { animation-name: juanosL1; }
    @keyframes juanosL1 {
      0%, 4% { opacity: 0; transform: translateY(-8px); }
      12%, 14% { opacity: .5; stroke: var(--faint); transform: translateY(-8px); }
      38%, 90% { opacity: 1; stroke: var(--paper); transform: translateY(0); }
      95%, 100% { opacity: 0; }
    }
    .juanos-l3 { animation-name: juanosL3; }
    @keyframes juanosL3 {
      0%, 4% { opacity: 0; }
      12%, 14% { opacity: .5; stroke: var(--faint); }
      38%, 90% { opacity: 1; stroke: var(--paper); }
      95%, 100% { opacity: 0; }
    }
    .juanos-l5 { animation-name: juanosL5; }
    @keyframes juanosL5 {
      0%, 4% { opacity: 0; transform: translateY(8px); }
      12%, 14% { opacity: .5; stroke: var(--faint); transform: translateY(8px); }
      38%, 90% { opacity: 1; stroke: var(--paper); transform: translateY(0); }
      95%, 100% { opacity: 0; }
    }

    /* 44-58%: the bracket draws itself along the gathered lines */
    .juanos-bracket {
      stroke-dasharray: 92;
      animation-name: juanosBracket;
      animation-timing-function: cubic-bezier(.3,0,.2,1);
    }
    @keyframes juanosBracket {
      0%, 43% { stroke-dashoffset: 92; opacity: 0; }
      46% { opacity: 1; }
      58%, 90% { stroke-dashoffset: 0; opacity: 1; }
      95%, 100% { stroke-dashoffset: 0; opacity: 0; }
    }

    /* the label lands, long hold */
    .juanos-label { animation-name: juanosLabel; }
    @keyframes juanosLabel {
      0%, 58% { opacity: 0; }
      63%, 90% { opacity: 1; }
      95%, 100% { opacity: 0; }
    }
  </style>
</svg>
