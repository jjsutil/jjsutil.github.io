<svg viewBox="0 0 220 88" preserveAspectRatio="xMidYMid meet" aria-hidden="true">
  <!-- bioinfo: four sparse rows of sequence ticks, a hairline sweeps across,
       three columns snap into alignment and ignite (conserved sites), hold,
       one label, soft reset. 10s master. Base attributes render the payoff
       (columns aligned + lit, sweep hidden) for the static/reduced-motion frame. -->

  <g class="bio-noise" stroke="var(--faint)" stroke-width="1" opacity=".3">
    <line x1="22" y1="16" x2="22" y2="24"/><line x1="40" y1="16" x2="40" y2="24"/>
    <line x1="94" y1="16" x2="94" y2="24"/><line x1="142" y1="16" x2="142" y2="24"/>
    <line x1="158" y1="16" x2="158" y2="24"/><line x1="192" y1="16" x2="192" y2="24"/>
    <line x1="30" y1="32" x2="30" y2="40"/><line x1="52" y1="32" x2="52" y2="40"/>
    <line x1="100" y1="32" x2="100" y2="40"/><line x1="134" y1="32" x2="134" y2="40"/>
    <line x1="182" y1="32" x2="182" y2="40"/><line x1="198" y1="32" x2="198" y2="40"/>
    <line x1="26" y1="48" x2="26" y2="56"/><line x1="46" y1="48" x2="46" y2="56"/>
    <line x1="88" y1="48" x2="88" y2="56"/><line x1="146" y1="48" x2="146" y2="56"/>
    <line x1="164" y1="48" x2="164" y2="56"/><line x1="188" y1="48" x2="188" y2="56"/>
    <line x1="34" y1="64" x2="34" y2="72"/><line x1="60" y1="64" x2="60" y2="72"/>
    <line x1="96" y1="64" x2="96" y2="72"/><line x1="138" y1="64" x2="138" y2="72"/>
    <line x1="178" y1="64" x2="178" y2="72"/><line x1="204" y1="64" x2="204" y2="72"/>
  </g>

  <line class="bio-sweep" x1="14" y1="10" x2="14" y2="78" stroke="var(--ember)" stroke-width="1"/>

  <g class="bio-col bio-col-a" transform="translate(70,0)">
    <line x1="0" y1="16" x2="0" y2="24" stroke="currentColor" stroke-width="1.4"/>
    <line x1="0" y1="32" x2="0" y2="40" stroke="currentColor" stroke-width="1.4"/>
    <line x1="0" y1="48" x2="0" y2="56" stroke="currentColor" stroke-width="1.4"/>
    <line x1="0" y1="64" x2="0" y2="72" stroke="currentColor" stroke-width="1.4"/>
  </g>
  <g class="bio-col bio-col-b" transform="translate(120,0)">
    <line x1="0" y1="16" x2="0" y2="24" stroke="currentColor" stroke-width="1.4"/>
    <line x1="0" y1="32" x2="0" y2="40" stroke="currentColor" stroke-width="1.4"/>
    <line x1="0" y1="48" x2="0" y2="56" stroke="currentColor" stroke-width="1.4"/>
    <line x1="0" y1="64" x2="0" y2="72" stroke="currentColor" stroke-width="1.4"/>
  </g>
  <g class="bio-col bio-col-c" transform="translate(170,0)">
    <line x1="0" y1="16" x2="0" y2="24" stroke="currentColor" stroke-width="1.4"/>
    <line x1="0" y1="32" x2="0" y2="40" stroke="currentColor" stroke-width="1.4"/>
    <line x1="0" y1="48" x2="0" y2="56" stroke="currentColor" stroke-width="1.4"/>
    <line x1="0" y1="64" x2="0" y2="72" stroke="currentColor" stroke-width="1.4"/>
  </g>

  <text class="bio-label" x="110" y="86" font-size="7" fill="var(--ok)" text-anchor="middle">p&lt;0.001</text>

  <style>
    .bio-col > line { color: var(--ok); }

    /* off-canvas at rest: the static/reduced-motion frame must not show the
       sweep, and global CSS forces opacity:1 there, so position (not opacity)
       carries the resting state. */
    .bio-sweep { transform: translateX(300px); animation: bioSweep 10s cubic-bezier(.5,0,.5,1) infinite; }
    @keyframes bioSweep {
      0%, 15% { transform: translateX(0); opacity: 0; }
      18% { opacity: .85; }
      70% { transform: translateX(192px); opacity: .85; }
      74%, 100% { transform: translateX(192px); opacity: 0; }
    }

    .bio-col-a > line { animation: bioColShiftA 10s cubic-bezier(.4,0,.2,1) infinite; }
    @keyframes bioColShiftA {
      0%, 27% { transform: translateX(-4px); color: var(--faint); opacity: .4; }
      30%, 96% { transform: translateX(0); color: var(--ok); opacity: 1; }
      100% { transform: translateX(-4px); color: var(--faint); opacity: .4; }
    }
    .bio-col-b > line { animation: bioColShiftB 10s cubic-bezier(.4,0,.2,1) infinite; }
    @keyframes bioColShiftB {
      0%, 41% { transform: translateX(-4px); color: var(--faint); opacity: .4; }
      44%, 96% { transform: translateX(0); color: var(--ok); opacity: 1; }
      100% { transform: translateX(-4px); color: var(--faint); opacity: .4; }
    }
    .bio-col-c > line { animation: bioColShiftC 10s cubic-bezier(.4,0,.2,1) infinite; }
    @keyframes bioColShiftC {
      0%, 55% { transform: translateX(-4px); color: var(--faint); opacity: .4; }
      58%, 96% { transform: translateX(0); color: var(--ok); opacity: 1; }
      100% { transform: translateX(-4px); color: var(--faint); opacity: .4; }
    }

    .bio-label { animation: bioLabel 10s ease-in-out infinite; }
    @keyframes bioLabel {
      0%, 62% { opacity: 0; }
      68%, 96% { opacity: 1; }
      100% { opacity: 0; }
    }
  </style>
</svg>
