<svg viewBox="0 0 220 88" preserveAspectRatio="xMidYMid meet" aria-hidden="true">
  <!-- vi2bo, abstracted: a jittery waveform (speech) sits in the left half; a
       hairline sweeps left to right and in its wake six straight, justified
       lines snap into place — disorder becoming typeset order. One label holds.
       One 10s master timeline. -->

  <polyline class="vi2bo-wave" fill="none" stroke="var(--faint)" stroke-width="0"
    stroke-linecap="round" stroke-linejoin="round"
    points="20,44 26,32 32,54 38,28 44,50 50,34 56,56 62,30 68,48 74,36 80,52 86,32 92,46 98,40"/>

  <line class="vi2bo-sweep" x1="20" y1="6" x2="20" y2="82" stroke="var(--ember)" stroke-width="0" stroke-linecap="round"/>

  <rect class="vi2bo-line vi2bo-line-1" x="20" y="14.9" height="2.2" rx="1.1" width="168" fill="var(--paper)"/>
  <rect class="vi2bo-line vi2bo-line-2" x="20" y="26.9" height="2.2" rx="1.1" width="145" fill="var(--paper)"/>
  <rect class="vi2bo-line vi2bo-line-3" x="20" y="38.9" height="2.2" rx="1.1" width="175" fill="var(--paper)"/>
  <rect class="vi2bo-line vi2bo-line-4" x="20" y="50.9" height="2.2" rx="1.1" width="130" fill="var(--paper)"/>
  <rect class="vi2bo-line vi2bo-line-5" x="20" y="62.9" height="2.2" rx="1.1" width="158" fill="var(--paper)"/>
  <rect class="vi2bo-line vi2bo-line-6" x="20" y="74.9" height="2.2" rx="1.1" width="140" fill="var(--paper)"/>

  <text class="vi2bo-label" x="202" y="78" font-size="8" text-anchor="end" fill="var(--paper)">pdf</text>

  <style>
    .vi2bo-wave, .vi2bo-sweep, .vi2bo-line, .vi2bo-label {
      animation-duration: 10s;
      animation-iteration-count: infinite;
      animation-timing-function: cubic-bezier(.4,0,.2,1);
    }

    /* the quiet waveform is present, then erased as the sweep clears it */
    .vi2bo-wave { animation-name: vi2boWave; }
    @keyframes vi2boWave {
      0%, 4% { stroke-width: 0; }
      9%, 11% { stroke-width: 1.3; }
      38%, 100% { stroke-width: 0; }
    }

    /* the reading sweep travels once, left to right */
    .vi2bo-sweep { animation-name: vi2boSweep; animation-timing-function: cubic-bezier(.5,0,.5,1); }
    @keyframes vi2boSweep {
      0%, 8% { transform: translateX(0); stroke-width: 0; }
      11% { stroke-width: 1.4; }
      56% { stroke-width: 1.4; transform: translateX(180px); }
      60%, 100% { stroke-width: 0; transform: translateX(180px); }
    }

    /* six lines snap into typeset order as the sweep passes each row */
    .vi2bo-line-1 { animation-name: vi2boLine1; }
    @keyframes vi2boLine1 {
      0%, 9% { width: 0; opacity: 0; }
      11% { opacity: .7; }
      16%, 96% { width: 168; opacity: 1; }
      100% { width: 168; opacity: 0; }
    }
    .vi2bo-line-2 { animation-name: vi2boLine2; }
    @keyframes vi2boLine2 {
      0%, 12% { width: 0; opacity: 0; }
      14% { opacity: .7; }
      19%, 96% { width: 145; opacity: 1; }
      100% { width: 145; opacity: 0; }
    }
    .vi2bo-line-3 { animation-name: vi2boLine3; }
    @keyframes vi2boLine3 {
      0%, 15% { width: 0; opacity: 0; }
      17% { opacity: .7; }
      22%, 96% { width: 175; opacity: 1; }
      100% { width: 175; opacity: 0; }
    }
    .vi2bo-line-4 { animation-name: vi2boLine4; }
    @keyframes vi2boLine4 {
      0%, 18% { width: 0; opacity: 0; }
      20% { opacity: .7; }
      25%, 96% { width: 130; opacity: 1; }
      100% { width: 130; opacity: 0; }
    }
    .vi2bo-line-5 { animation-name: vi2boLine5; }
    @keyframes vi2boLine5 {
      0%, 21% { width: 0; opacity: 0; }
      23% { opacity: .7; }
      28%, 96% { width: 158; opacity: 1; }
      100% { width: 158; opacity: 0; }
    }
    .vi2bo-line-6 { animation-name: vi2boLine6; }
    @keyframes vi2boLine6 {
      0%, 24% { width: 0; opacity: 0; }
      26% { opacity: .7; }
      31%, 96% { width: 140; opacity: 1; }
      100% { width: 140; opacity: 0; }
    }

    /* the label lands once the page settles, holds, soft-fades in the final 4% */
    .vi2bo-label { animation-name: vi2boLabel; }
    @keyframes vi2boLabel {
      0%, 47% { opacity: 0; }
      53%, 96% { opacity: 1; }
      100% { opacity: 0; }
    }
  </style>
</svg>
