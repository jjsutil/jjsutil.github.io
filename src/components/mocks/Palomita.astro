<style>
  .palo-bird{transform-box:fill-box;transform-origin:center;animation:paloFly 3.6s ease-in-out infinite}
  .palo-dot{transform-box:fill-box;transform-origin:center;animation:paloPulse 2.2s ease-in-out infinite}
  .palo-envelope{transform-box:fill-box;transform-origin:center;animation:paloEnvelope 3.6s ease-in-out infinite}
  @keyframes paloFly{
    0%{transform:translate(-80px,30px) scale(.6)}
    25%{transform:translate(-44px,6px) scale(.8)}
    50%{transform:translate(0,0) scale(1)}
    75%{transform:translate(46px,4px) scale(1.05)}
    100%{transform:translate(80px,24px) scale(.9)}
  }
  @keyframes paloPulse{0%,100%{opacity:.35;transform:scale(.85)}50%{opacity:1;transform:scale(1.15)}}
  @keyframes paloEnvelope{0%,70%{opacity:.8;transform:scale(1)}85%,95%{opacity:1;transform:scale(1.1)}100%{opacity:.8;transform:scale(1)}}
</style>
