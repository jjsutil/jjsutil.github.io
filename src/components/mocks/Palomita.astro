<svg viewBox="0 0 220 88" preserveAspectRatio="xMidYMid meet" aria-hidden="true">
  <!-- palomita: a loose cluster of repos on the left, a dashed hairline arc to a
       single point on the right. A lone dot travels the arc, calm, not a race.
       On arrival the letter materializes, staggered, and holds. One 11s
       master timeline. -->

  <!-- the cluster: four or five quiet points -->
  <g class="palo-cluster" fill="var(--faint)">
    <circle cx="20" cy="36" r="1.4"/>
    <circle cx="28" cy="30" r="1.2"/>
    <circle cx="16" cy="48" r="1.3"/>
    <circle cx="26" cy="54" r="1.1"/>
    <circle cx="22" cy="42" r="1.4"/>
  </g>

  <!-- the dashed hairline arc -->
  <path class="palo-arc" d="M22 42 Q108 16 194 44"
    fill="none" stroke="var(--faint)" stroke-width="1" stroke-dasharray="2 5"/>

  <!-- the lone traveller -->
  <circle class="palo-dot" cx="0" cy="0" r="1.8" fill="var(--paper)">
    <animateMotion dur="11s" repeatCount="indefinite"
      path="M22 42 Q108 16 194 44"
      keyPoints="0;0;1;1" keyTimes="0;0.14;0.5;1"
      calcMode="spline" keySplines="0 0 1 1; .5 0 .3 1; 0 0 1 1"/>
  </circle>

  <!-- the destination: ignites on arrival -->
  <circle class="palo-dest" cx="194" cy="44" r="2" fill="var(--ember)"/>

  <!-- the letter: three short lines materialize beside it, staggered -->
  <g class="palo-letter" stroke="var(--ember)" stroke-width="1.4" stroke-linecap="round">
    <line class="palo-l1" x1="202" y1="36" x2="214" y2="36"/>
    <line class="palo-l2" x1="202" y1="44" x2="214" y2="44"/>
    <line class="palo-l3" x1="202" y1="52" x2="214" y2="52"/>
  </g>

  <text class="palo-label" x="150" y="66" font-size="7" fill="var(--faint)">mon 09:00</text>

  <style>
    .palo-cluster, .palo-arc, .palo-dot, .palo-dest, .palo-l1, .palo-l2, .palo-l3, .palo-label {
      animation-duration: 11s;
      animation-iteration-count: infinite;
      animation-timing-function: ease-in-out;
    }

    /* setup: the cluster and the guide appear */
    .palo-cluster { animation-name: paloCluster; }
    @keyframes paloCluster {
      0%, 3% { opacity: 0; }
      10%, 90% { opacity: .8; }
      96%, 100% { opacity: 0; }
    }

    .palo-arc { animation-name: paloArc; }
    @keyframes paloArc {
      0%, 8% { opacity: 0; }
      14%, 90% { opacity: .6; }
      96%, 100% { opacity: 0; }
    }

    /* 14-48%: the dot travels, calm (motion path above) */
    .palo-dot { animation-name: paloDot; }
    @keyframes paloDot {
      0%, 13% { opacity: 0; }
      16%, 47% { opacity: 1; }
      50%, 100% { opacity: 0; }
    }

    /* ~48%: arrival — the destination ignites and stays */
    .palo-dest {
      animation-name: paloDest;
      animation-timing-function: cubic-bezier(.3,0,.2,1);
    }
    @keyframes paloDest {
      0%, 46% { opacity: 0; transform: scale(.4); }
      50%, 90% { opacity: 1; transform: scale(1); }
      96%, 100% { opacity: 0; }
    }

    /* 50-64%: the letter materializes, ease-out, staggered */
    .palo-l1, .palo-l2, .palo-l3 {
      animation-timing-function: cubic-bezier(0,0,.2,1);
    }
    .palo-l1 { animation-name: paloL1; }
    @keyframes paloL1 {
      0%, 49% { opacity: 0; transform: translateX(4px); }
      55%, 90% { opacity: 1; transform: translateX(0); }
      96%, 100% { opacity: 0; }
    }
    .palo-l2 { animation-name: paloL2; }
    @keyframes paloL2 {
      0%, 53% { opacity: 0; transform: translateX(4px); }
      59%, 90% { opacity: 1; transform: translateX(0); }
      96%, 100% { opacity: 0; }
    }
    .palo-l3 { animation-name: paloL3; }
    @keyframes paloL3 {
      0%, 57% { opacity: 0; transform: translateX(4px); }
      63%, 90% { opacity: 1; transform: translateX(0); }
      96%, 100% { opacity: 0; }
    }

    /* the label lands, holds */
    .palo-label { animation-name: paloLabel; }
    @keyframes paloLabel {
      0%, 63% { opacity: 0; }
      68%, 90% { opacity: 1; }
      96%, 100% { opacity: 0; }
    }
  </style>
</svg>
