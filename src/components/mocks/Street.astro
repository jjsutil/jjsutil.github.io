<svg viewBox="0 0 220 88" preserveAspectRatio="xMidYMid meet" aria-hidden="true">
  <!-- street, abstracted: a long faint line (a street's profile) is walked by a
       slow ember pulse; at three fixed spots the line itself dips as the pulse
       passes — damage, made literal. The deepest dip earns the only label, and
       the scarred profile holds. One 11s master timeline. -->

  <path class="street-line" d="M15,48 L65,48 L70,54 L75,48 L115,48 L120,60 L125,48 L165,48 L170,54 L175,48 L205,48"
    fill="none" stroke="var(--faint)" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>

  <g class="street-pulse">
    <circle class="street-pulse-glow" cx="15" cy="48" r="0" fill="var(--ember)" opacity=".35"/>
    <circle class="street-pulse-core" cx="15" cy="48" r="0" fill="var(--ember)"/>
  </g>

  <text class="street-label" x="124" y="70" font-size="8" fill="var(--rust)">.93</text>

  <style>
    .street-line, .street-pulse, .street-pulse-glow, .street-pulse-core, .street-label {
      animation-duration: 11s;
      animation-iteration-count: infinite;
      animation-timing-function: cubic-bezier(.4,0,.2,1);
    }

    /* the pulse travels once along the profile, slow */
    .street-pulse { animation-name: streetPulseMove; animation-timing-function: cubic-bezier(.43,0,.23,1); }
    @keyframes streetPulseMove {
      0%, 10% { transform: translateX(0); }
      78%, 100% { transform: translateX(190px); }
    }

    /* 0-10%: the profile settles in */
    .street-line { animation-name: streetFade, streetMorph; }
    @keyframes streetFade {
      0%, 6% { opacity: 0; }
      10%, 100% { opacity: 1; }
    }

    /* the line deforms at each fixed spot as the pulse passes it, and stays scarred */
    @keyframes streetMorph {
      0%, 28% { d: path("M15,48 L65,48 L70,48 L75,48 L115,48 L120,48 L125,48 L165,48 L170,48 L175,48 L205,48"); }
      31%, 46% { d: path("M15,48 L65,48 L70,54 L75,48 L115,48 L120,48 L125,48 L165,48 L170,48 L175,48 L205,48"); }
      49%, 64% { d: path("M15,48 L65,48 L70,54 L75,48 L115,48 L120,60 L125,48 L165,48 L170,48 L175,48 L205,48"); }
      67%, 100% { d: path("M15,48 L65,48 L70,54 L75,48 L115,48 L120,60 L125,48 L165,48 L170,54 L175,48 L205,48"); }
    }

    /* the pulse itself is only visible while it travels */
    .street-pulse-glow { animation-name: streetPulseGlow; transform-box: fill-box; }
    @keyframes streetPulseGlow {
      0%, 8% { r: 0; opacity: 0; }
      13%, 73% { r: 5; opacity: .35; }
      78%, 100% { r: 0; opacity: 0; }
    }
    .street-pulse-core { animation-name: streetPulseCore; transform-box: fill-box; }
    @keyframes streetPulseCore {
      0%, 8% { r: 0; opacity: 0; }
      13%, 73% { r: 2; opacity: 1; }
      78%, 100% { r: 0; opacity: 0; }
    }

    /* the deepest notch earns the label once the profile is fully scarred, holds, soft-fades */
    .street-label { animation-name: streetLabel; }
    @keyframes streetLabel {
      0%, 68% { opacity: 0; }
      73%, 96% { opacity: 1; }
      100% { opacity: 0; }
    }
  </style>
</svg>
