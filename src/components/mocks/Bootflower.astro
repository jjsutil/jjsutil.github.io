<svg viewBox="0 0 220 88" preserveAspectRatio="xMidYMid meet" aria-hidden="true">
  <!-- bootflower, abstracted: a point verifies itself closed in a ring, then
       sends four hairlines outward, each closing its own small ring in turn
       — a constellation of verified nodes. one label. 12s. -->

  <circle class="boot-dot" cx="60" cy="44" r="2" fill="var(--ember)"/>

  <circle class="boot-ring" cx="60" cy="44" r="10" pathLength="1" stroke-dasharray="1"
    fill="none" stroke="var(--ember)" stroke-width="1.6" transform="rotate(-90 60 44)"/>

  <g fill="none" stroke="var(--faint)" stroke-width="1">
    <path class="boot-h1" d="M60 44 L110 18" pathLength="1" stroke-dasharray="1"/>
    <path class="boot-h2" d="M60 44 L150 30" pathLength="1" stroke-dasharray="1"/>
    <path class="boot-h3" d="M60 44 L150 58" pathLength="1" stroke-dasharray="1"/>
    <path class="boot-h4" d="M60 44 L110 70" pathLength="1" stroke-dasharray="1"/>
  </g>

  <g fill="none" stroke="var(--ember)" stroke-width="1.3" opacity=".6">
    <circle class="boot-r1" cx="110" cy="18" r="5" pathLength="1" stroke-dasharray="1" transform="rotate(-90 110 18)"/>
    <circle class="boot-r2" cx="150" cy="30" r="5" pathLength="1" stroke-dasharray="1" transform="rotate(-90 150 30)"/>
    <circle class="boot-r3" cx="150" cy="58" r="5" pathLength="1" stroke-dasharray="1" transform="rotate(-90 150 58)"/>
    <circle class="boot-r4" cx="110" cy="70" r="5" pathLength="1" stroke-dasharray="1" transform="rotate(-90 110 70)"/>
  </g>

  <text class="boot-label" x="60" y="60" font-size="7" fill="var(--faint)" text-anchor="middle">verified</text>

  <style>
    .boot-dot, .boot-ring, .boot-h1, .boot-h2, .boot-h3, .boot-h4,
    .boot-r1, .boot-r2, .boot-r3, .boot-r4, .boot-label {
      animation-duration: 12s;
      animation-iteration-count: infinite;
      animation-timing-function: cubic-bezier(.4,0,.2,1);
    }

    /* 0-6%: the point settles in; long hold; soft reset */
    .boot-dot { animation-name: bootDot; }
    @keyframes bootDot {
      0% { opacity: 0; }
      6%, 96% { opacity: 1; }
      100% { opacity: 0; }
    }

    /* 8-30%: the ring verifies itself closed around the point */
    .boot-ring { animation-name: bootRing; animation-timing-function: cubic-bezier(.3,0,.2,1); }
    @keyframes bootRing {
      0%, 6% { opacity: 0; stroke-dashoffset: 1; }
      8% { opacity: 1; }
      30%, 96% { stroke-dashoffset: 0; opacity: 1; }
      100% { opacity: 0; }
    }

    /* 36-58%: four hairlines grow outward, staggered, ease-out */
    .boot-h1, .boot-h2, .boot-h3, .boot-h4 { animation-timing-function: cubic-bezier(.2,.6,.25,1); }
    .boot-h1 { animation-name: bootH1; }
    @keyframes bootH1 { 0%, 36% { opacity: 0; stroke-dashoffset: 1; } 38% { opacity: 1; } 46%, 96% { stroke-dashoffset: 0; opacity: 1; } 100% { opacity: 0; } }
    .boot-h2 { animation-name: bootH2; }
    @keyframes bootH2 { 0%, 40% { opacity: 0; stroke-dashoffset: 1; } 42% { opacity: 1; } 50%, 96% { stroke-dashoffset: 0; opacity: 1; } 100% { opacity: 0; } }
    .boot-h3 { animation-name: bootH3; }
    @keyframes bootH3 { 0%, 44% { opacity: 0; stroke-dashoffset: 1; } 46% { opacity: 1; } 54%, 96% { stroke-dashoffset: 0; opacity: 1; } 100% { opacity: 0; } }
    .boot-h4 { animation-name: bootH4; }
    @keyframes bootH4 { 0%, 48% { opacity: 0; stroke-dashoffset: 1; } 50% { opacity: 1; } 58%, 96% { stroke-dashoffset: 0; opacity: 1; } 100% { opacity: 0; } }

    /* 46-68%: each satellite ring closes just behind its hairline */
    .boot-r1, .boot-r2, .boot-r3, .boot-r4 { animation-timing-function: cubic-bezier(.3,0,.2,1); }
    .boot-r1 { animation-name: bootR1; }
    @keyframes bootR1 { 0%, 46% { opacity: 0; stroke-dashoffset: 1; } 48% { opacity: 1; } 56%, 96% { stroke-dashoffset: 0; opacity: 1; } 100% { opacity: 0; } }
    .boot-r2 { animation-name: bootR2; }
    @keyframes bootR2 { 0%, 50% { opacity: 0; stroke-dashoffset: 1; } 52% { opacity: 1; } 60%, 96% { stroke-dashoffset: 0; opacity: 1; } 100% { opacity: 0; } }
    .boot-r3 { animation-name: bootR3; }
    @keyframes bootR3 { 0%, 54% { opacity: 0; stroke-dashoffset: 1; } 56% { opacity: 1; } 64%, 96% { stroke-dashoffset: 0; opacity: 1; } 100% { opacity: 0; } }
    .boot-r4 { animation-name: bootR4; }
    @keyframes bootR4 { 0%, 58% { opacity: 0; stroke-dashoffset: 1; } 60% { opacity: 1; } 68%, 96% { stroke-dashoffset: 0; opacity: 1; } 100% { opacity: 0; } }

    /* 68-74%: the constellation is named; payoff holds to 96%; soft reset */
    .boot-label { animation-name: bootLabel; }
    @keyframes bootLabel {
      0%, 68% { opacity: 0; }
      74%, 96% { opacity: 1; }
      100% { opacity: 0; }
    }
  </style>
</svg>
