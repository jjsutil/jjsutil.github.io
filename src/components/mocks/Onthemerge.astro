<svg viewBox="0 0 220 88" preserveAspectRatio="xMidYMid meet" aria-hidden="true">
  <!-- onthemerge: two quiet lines run parallel; the upper curves down into the
       lower, the joined line ignites and holds. A tiny burst marks the instant,
       one deadpan label. One 9s master timeline. -->

  <!-- lower line, the segment before the merge point (always faint) -->
  <line class="merge-loA" x1="20" y1="58" x2="120" y2="58"
    stroke="var(--faint)" stroke-width="1.4" stroke-linecap="round"/>

  <!-- upper line, curving down toward the merge -->
  <path class="merge-hi" d="M20 28 C 66 28, 96 40, 120 58"
    fill="none" stroke="var(--faint)" stroke-width="1.4" stroke-linecap="round"/>

  <!-- the joined line: ignites ember at the merge instant, stays -->
  <line class="merge-lo" x1="120" y1="58" x2="198" y2="58"
    stroke="var(--ember)" stroke-width="1.6" stroke-linecap="round"/>

  <!-- the burst -->
  <g class="merge-burst" fill="var(--ember)">
    <circle class="merge-p" cx="120" cy="58" r="1.2" style="--a:10deg; --d:15px"/>
    <circle class="merge-p" cx="120" cy="58" r="1.1" style="--a:55deg; --d:12px"/>
    <circle class="merge-p" cx="120" cy="58" r="1.3" style="--a:-28deg; --d:14px"/>
    <circle class="merge-p" cx="120" cy="58" r="1"   style="--a:-64deg; --d:11px"/>
    <circle class="merge-p" cx="120" cy="58" r="1.2" style="--a:100deg; --d:13px"/>
    <circle class="merge-p" cx="120" cy="58" r="1"   style="--a:-104deg; --d:10px"/>
  </g>

  <text class="merge-label" x="128" y="40" font-size="8" fill="var(--ember)">FAHH!</text>

  <style>
    .merge-loA, .merge-hi, .merge-lo, .merge-p, .merge-label {
      animation-duration: 9s;
      animation-iteration-count: infinite;
      animation-timing-function: ease-in-out;
    }

    /* two faint lines run parallel */
    .merge-loA {
      stroke-dasharray: 100;
      animation-name: mergeLoA;
    }
    @keyframes mergeLoA {
      0%, 4% { stroke-dashoffset: 100; opacity: 0; }
      9% { opacity: .7; }
      30%, 90% { stroke-dashoffset: 0; opacity: .7; }
      96%, 100% { stroke-dashoffset: 0; opacity: 0; }
    }

    .merge-hi {
      stroke-dasharray: 140;
      animation-name: mergeHi;
      animation-timing-function: cubic-bezier(.4,0,.2,1);
    }
    @keyframes mergeHi {
      0%, 4% { stroke-dashoffset: 140; opacity: 0; }
      9% { opacity: .7; }
      30%, 39% { stroke-dashoffset: 0; opacity: .7; }
      44%, 100% { opacity: 0; }
    }

    /* ~40%: the merge — the joined line ignites and draws itself, and stays */
    .merge-lo {
      stroke-dasharray: 78;
      animation-name: mergeLo;
      animation-timing-function: cubic-bezier(.3,0,.2,1);
    }
    @keyframes mergeLo {
      0%, 39% { stroke-dashoffset: 78; opacity: 0; }
      41% { opacity: 1; }
      46%, 90% { stroke-dashoffset: 0; opacity: 1; }
      96%, 100% { stroke-dashoffset: 0; opacity: 0; }
    }

    /* the burst: a quick radial ejection, ease-out, fades */
    .merge-p {
      animation-name: mergeBurst;
      animation-timing-function: cubic-bezier(0,0,.2,1);
    }
    @keyframes mergeBurst {
      0%, 39% { transform: rotate(var(--a)) translateX(0); opacity: 0; }
      41% { opacity: 1; transform: rotate(var(--a)) translateX(2px); }
      52%, 100% { opacity: 0; transform: rotate(var(--a)) translateX(var(--d)); }
    }

    /* the one deadpan joke — pops once, holds */
    .merge-label {
      animation-name: mergeLabel;
    }
    @keyframes mergeLabel {
      0%, 41% { opacity: 0; }
      46%, 90% { opacity: 1; }
      96%, 100% { opacity: 0; }
    }
  </style>
</svg>
