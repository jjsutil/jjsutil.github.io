<svg viewBox="0 0 220 88" preserveAspectRatio="xMidYMid meet" aria-hidden="true">
  <!-- speed, abstracted: a faint horizontal line (the road), a bright streak with
       a fading tail crosses it fast, and as it passes center two corner brackets
       close around the captured point and stay. One label holds. One 9s master
       timeline. -->

  <defs>
    <linearGradient id="speed-tail" x1="0" y1="0" x2="1" y2="0">
      <stop offset="0" stop-color="var(--ember)" stop-opacity="0"/>
      <stop offset="1" stop-color="var(--ember)" stop-opacity="1"/>
    </linearGradient>
  </defs>

  <line class="speed-road" x1="15" y1="48" x2="205" y2="48" stroke="var(--faint)" stroke-width="1"/>

  <line class="speed-streak" x1="5" y1="48" x2="19" y2="48" stroke="url(#speed-tail)" stroke-width="0" stroke-linecap="round"/>

  <path class="speed-bracket" d="M104,36 L94,36 L94,60 L104,60" fill="none" stroke="var(--ember)"
    stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" pathLength="1" stroke-dasharray="1"/>
  <path class="speed-bracket" d="M124,36 L134,36 L134,60 L124,60" fill="none" stroke="var(--ember)"
    stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" pathLength="1" stroke-dasharray="1"/>

  <circle class="speed-dot" cx="114" cy="48" r="2" fill="var(--ember)"/>

  <text class="speed-label" x="114" y="76" font-size="8" text-anchor="middle" fill="var(--paper)">142 km/h</text>

  <style>
    .speed-road, .speed-streak, .speed-bracket, .speed-dot, .speed-label {
      animation-duration: 9s;
      animation-iteration-count: infinite;
      animation-timing-function: cubic-bezier(.4,0,.2,1);
    }

    /* 0-10%: the road settles in */
    .speed-road { animation-name: speedRoad; }
    @keyframes speedRoad {
      0%, 7% { opacity: 0; }
      10%, 100% { opacity: 1; }
    }

    /* the streak crosses fast, tail fading behind it */
    .speed-streak { animation-name: speedStreak, speedStreakMove; }
    @keyframes speedStreak {
      0%, 5% { stroke-width: 0; }
      9%, 46% { stroke-width: 2.2; }
      52%, 100% { stroke-width: 0; }
    }
    @keyframes speedStreakMove {
      0%, 7% { transform: translateX(0); }
      48%, 100% { transform: translateX(196px); }
    }

    /* ~30%: as it crosses center, the brackets close around the capture and stay */
    .speed-bracket { animation-name: speedBracket; }
    @keyframes speedBracket {
      0%, 25% { stroke-dashoffset: 1; opacity: 0; }
      28% { opacity: 1; }
      32%, 96% { stroke-dashoffset: 0; opacity: 1; }
      100% { opacity: 0; }
    }
    .speed-dot { animation-name: speedDot; transform-box: fill-box; transform-origin: center; }
    @keyframes speedDot {
      0%, 25% { r: 0; opacity: 0; }
      30% { r: 2.6; opacity: 1; }
      34%, 96% { r: 2; opacity: 1; }
      100% { r: 2; opacity: 0; }
    }

    /* the readout lands under the capture, holds while the streak exits, soft-fades */
    .speed-label { animation-name: speedLabel; }
    @keyframes speedLabel {
      0%, 33% { opacity: 0; }
      40%, 96% { opacity: 1; }
      100% { opacity: 0; }
    }
  </style>
</svg>
