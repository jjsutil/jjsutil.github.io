---
import { t } from '../data/i18n';
---

<section id="track">
  <h2 data-i18n="tr_h2">{t('tr_h2')}</h2>
  <p class="lede" data-i18n="tr_lede">{t('tr_lede')}</p>
  <div class="track">
    <div class="row reveal">
      <div class="when">2026 — now</div>
      <div>
        <h3>Founding Software Engineer · <span>pin</span></h3>
        <p data-i18n="t0_p">{t('t0_p')}</p>
        <a class="more" href="https://jjsutil.github.io/pin-landing/" target="_blank" rel="noopener">pin →</a>
      </div>
    </div>
    <div class="row reveal">
      <div class="when">2025 — 2026</div>
      <div>
        <h3>Full-stack Development Software Engineer · <span>HealthAtom</span></h3>
        <p data-i18n="t1_p">{t('t1_p')}</p>
        <a class="more" href="https://healthatom.com" target="_blank" rel="noopener">healthatom.com →</a>
      </div>
    </div>
    <div class="row reveal">
      <div class="when">2025</div>
      <div>
        <h3>Founding First Software Engineer · <span>Talia</span></h3>
        <p data-i18n="t2_p">{t('t2_p')}</p>
      </div>
    </div>
    <div class="row reveal">
      <div class="when">2025</div>
      <div>
        <h3>STEM Education Advisor · <span>CNTV / Argumental Films</span></h3>
        <p data-i18n="t3_p">{t('t3_p')}</p>
        <a class="more" href="https://cntvinfantil.cl/series/manos-al-experimento/" target="_blank" rel="noopener" data-i18n="t3_link">{t('t3_link')}</a>
      </div>
    </div>
    <div class="row reveal">
      <div class="when">2023 — 2025</div>
      <div>
        <h3>Full-stack Software Engineer · <span>Reimpact</span></h3>
        <p data-i18n="t4_p">{t('t4_p')}</p>
        <a class="more" href="https://reimpact.cl" target="_blank" rel="noopener">reimpact.cl →</a>
      </div>
    </div>
    <div class="row reveal">
      <div class="when">2019 — 2021</div>
      <div>
        <h3>Research &amp; Internships · <span>PUC Chile / Astro-Engineering Center</span></h3>
        <p data-i18n="t5_p">{t('t5_p')}</p>
        <a class="more" href="https://www.aiuc.puc.cl/" target="_blank" rel="noopener">aiuc.puc.cl →</a>
      </div>
    </div>
  </div>
</section>
